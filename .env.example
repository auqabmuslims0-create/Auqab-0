# سوق الحسينية - متغيرات البيئة
# انسخ: cp .env.example .env

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
PORT=8000

# Database (محلياً: SQLite بدون DATABASE_URL)
# Railway: postgresql://user:pass@host:5432/db
# DATABASE_URL=

# JWT (اختياري - يولَّد محلياً إن فارغ)
# JWT_SECRET_KEY=

# Cloudinary (اختياري)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push Notifications (VAPID)
# PUSH_ENABLED: 1 = مفعّل، 0 = معطّل
# إن لم يُضبط: مفعّل في الإنتاج، معطّل في التطوير
# PUSH_ENABLED=1
# VAPID_SUBJECT=mailto:admin@example.com
# APP_BASE_URL=https://your-domain.com

# المدير (يُنشأ عند أول تشغيل)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+963999999999
ADMIN_PASSWORD=ChangeMeStrongPassword!2024

# Scheduler (1 = مفعّل)
SCHEDULER_ENABLED=0

# ProxyFix (1 = Railway)
TRUST_PROXY_HEADERS=0
