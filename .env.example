# سوق الحسينية — متغيرات البيئة
# انسخ: cp .env.example .env

# Flask
# development (افتراضي) | production (HTTPS صارم + Secure cookies)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000

# إلزامي في الإنتاج. ولّده بـ: python3 -c "import secrets; print(secrets.token_hex(32))"
# في التطوير: يُولَّد تلقائيًا في instance/.secret_key إن فارغ
SECRET_KEY=change-me-to-a-long-random-string

# Database
# محليًا: اتركه فارغًا لاستخدام SQLite (husayniyyah.db)
# Railway: postgresql://user:pass@host:5432/db (يُضاف تلقائيًا عند ربط Postgres)
# DATABASE_URL=

# JWT
# إلزامي في الإنتاج. ولّده بـ: python3 -c "import secrets; print(secrets.token_hex(32))"
# في التطوير: يُولَّد تلقائيًا في instance/.jwt_secret_key إن فارغ
# JWT_SECRET_KEY=

# Cloudinary (اختياري — بدونها تُخزَّن الوسائط محليًا)
# في الإنتاج موصى به بشدة (Railway ephemeral filesystem يمسح static/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push Notifications (VAPID)
# PUSH_ENABLED: 1 = مفعّل، 0 = معطّل
# إن لم يُضبط: مفعّل تلقائيًا في الإنتاج، معطّل في التطوير
# PUSH_ENABLED=1
# VAPID_SUBJECT=mailto:admin@example.com
# APP_BASE_URL=https://your-domain.com

# المدير (يُنشأ عند أول تشغيل عبر flask create-admin)
# إلزامي في الإنتاج. بدونها لا يُنشأ admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+963999999999
ADMIN_PASSWORD=ChangeMeStrongPassword!2024

# Scheduler (مهام الاشتراكات الدورية)
# 1 = مفعّل، 0 = معطّل
# في الإنتاج (Railway): يجب ضبطه إلى 1.
# في التطوير: اتركه 0 لتجنّب مهام دورية محليًا.
SCHEDULER_ENABLED=0

# ProxyFix (1 = خلف reverse proxy مثل Railway)
# 1 = يقرأ X-Forwarded-For / X-Forwarded-Proto من proxy موثوق.
# 0 = يستخدم request.remote_addr المباشر.
TRUST_PROXY_HEADERS=0
